{
  "name": "llmproxy2",
  "version": "2.1.3",
  "description": "LLMProxy2 (OCRProxy v2) — High-Performance Zero-Overhead AI Gateway",
  "private": true,
  "type": "module",
  "scripts": {
    "build:admin": "node shared/admin/build.mjs",
    "build:presets": "node shared/presets/build-catalog.mjs",
    "build:release": "node scripts/build-release.mjs",
    "catalog:build": "node scripts/model-catalog/build-catalog.mjs /tmp/modelsdev/api.json",
    "catalog:check": "node scripts/model-catalog/build-catalog.mjs /tmp/modelsdev/api.json --check",
    "catalog:fixture": "node scripts/model-catalog/build-catalog.mjs /tmp/modelsdev/api.json --fixture=anthropic,openai,deepseek,zhipuai,moonshotai",
    "magpie:check": "node scripts/magpie-sync.mjs check",
    "magpie:apply": "node scripts/magpie-sync.mjs apply",
    "test:hub": "node --test edgeone-hub/test/hub.test.mjs",
    "test:admin": "node shared/admin/build.mjs",
    "test:catalog": "node --test scripts/model-catalog/build-catalog.test.mjs",
    "test:t1": "node --test tests/t1_contracts/verify_contracts.test.mjs scripts/model-catalog/build-catalog.test.mjs",
    "test:t3": "node --test tests/t3_e2e/e2e.test.mjs",
    "test:full": "npm run test:t1 && npm run test:hub && go test -race ./... && npm run test:t3",
    "verify:release": "node scripts/verify-release.mjs",
    "test": "npm run test:t1 && npm run test:hub",
    "magpie:presets:check": "node scripts/magpie-presets.mjs check",
    "magpie:presets:import": "node scripts/magpie-presets.mjs import"
  },
  "devDependencies": {},
  "dependencies": {}
}
