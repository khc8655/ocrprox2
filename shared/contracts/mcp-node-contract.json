{
  "contract_version": 1,
  "updated_at": "2026-11-15",
  "architecture": "one_way_pull_zero_heartbeat",
  "endpoint": {
    "method": "POST",
    "path": "/api/node/config",
    "auth": "Authorization: Bearer stk_node_<48hex>",
    "headers": {
      "Authorization": "Bearer <NODE_TOKEN>",
      "Content-Type": "application/json",
      "If-None-Match": "<previous ETag> (optional)"
    }
  },
  "request_body": {
    "telemetry": {
      "description": "Optional on-demand runtime snapshot piggybacked when syncing/renewing config. Zero background heartbeats.",
      "fields": {
        "version": "string (optional, max 64 chars, secrets scrubbed)",
        "uptime_sec": "integer >= 0 (optional)",
        "playwright_ready": "boolean (optional)",
        "search_count": "integer >= 0 (optional)",
        "crawl_count": "integer >= 0 (optional)",
        "resting_keys": "string[] (optional, max 20 sanitized identifiers/labels, never raw keys)",
        "resting_keys_count": "integer >= 0 (optional)",
        "last_error": "string (optional, max 240 chars, secrets scrubbed)"
      }
    }
  },
  "response_200": {
    "status": 200,
    "headers": ["etag", "x-config-version", "cache-control"],
    "required_fields": ["ok", "_version", "etag", "lease_ttl", "grace_ttl", "issued_at", "payload"],
    "payload_fields": ["providers", "agent_models", "settings", "adapter_rules", "search_providers", "search_selection"],
    "search_provider_fields": ["id", "name", "enabled", "origin", "base_url", "capabilities", "timeout_ms", "api_keys"],
    "search_provider_optional_fields": ["adapter", "quirks", "request", "response", "fetch"],
    "search_key_fields": ["id", "label", "key", "enabled", "origin"],
    "search_selection_fields": ["search", "fetch"]
  },
  "response_304": {
    "status": 304,
    "headers": ["etag", "x-config-version", "x-lease-ttl", "x-grace-ttl"],
    "body": null
  },
  "sample_request": {
    "telemetry": {
      "version": "1.2.0",
      "uptime_sec": 3600,
      "playwright_ready": true,
      "search_count": 42,
      "crawl_count": 7,
      "resting_keys": ["tavily:k2"],
      "resting_keys_count": 1,
      "last_error": ""
    }
  },
  "sample_200_response": {
    "ok": true,
    "_version": 12,
    "etag": "\"abc123def456\"",
    "lease_ttl": 86400,
    "grace_ttl": 3600,
    "issued_at": "2026-11-15T12:00:00.000Z",
    "payload": {
      "providers": {},
      "agent_models": {},
      "settings": {},
      "adapter_rules": {},
      "search_providers": {
        "brave": {
          "id": "brave",
          "name": "Brave Search",
          "enabled": true,
          "origin": "vault",
          "base_url": "https://api.search.brave.com",
          "capabilities": ["search"],
          "timeout_ms": 10000,
          "adapter": "brave",
          "api_keys": [
            {
              "id": "k1",
              "label": "k1",
              "key": "BSA-example-key-value",
              "enabled": true,
              "origin": "vault"
            }
          ]
        },
        "jina": {
          "id": "jina",
          "name": "Jina Reader / Search",
          "enabled": true,
          "origin": "vault",
          "base_url": "https://s.jina.ai",
          "capabilities": ["search", "fetch"],
          "timeout_ms": 15000,
          "adapter": "jina",
          "api_keys": [
            {
              "id": "k1",
              "label": "k1",
              "key": "jina_example-key-value",
              "enabled": true,
              "origin": "vault"
            }
          ]
        }
      },
      "search_selection": {
        "search": ["brave", "jina"],
        "fetch": "jina"
      }
    }
  },
  "compatibility_rules": [
    "Hub changes to payload/telemetry MUST be additive; breaking removals or semantic changes MUST bump contract_version.",
    "Downstream consumers MUST ignore unrecognized keys in payload.",
    "Nodes MUST NOT poll on fixed background heartbeat timers; send telemetry only when requesting POST /api/node/config for startup, lease expiry, or upstream auth error recovery.",
    "Never place raw API keys or bearer tokens inside telemetry fields; Hub additionally scrubs secrets before KV storage."
  ]
}
