{
  "$comment": "Backend contract for LLMProxy2 shared Admin UI and Node communication across hub, lite, and full roles.",
  "version": 2,
  "capabilities": {
    "hub": {
      "vaultHub": true,
      "nodeManager": true,
      "vaultClient": false,
      "runModes": false,
      "kbModels": false,
      "oauthLogin": false,
      "usageAndTraces": false,
      "systemUpdate": false
    },
    "full": {
      "vaultHub": false,
      "nodeManager": false,
      "vaultClient": true,
      "runModes": true,
      "kbModels": true,
      "oauthLogin": true,
      "usageAndTraces": true,
      "systemUpdate": true
    },
    "lite": {
      "vaultHub": false,
      "nodeManager": false,
      "vaultClient": false,
      "runModes": false,
      "kbModels": false,
      "oauthLogin": false,
      "usageAndTraces": false,
      "systemUpdate": false
    }
  },
  "endpoints": {
    "config_read": {
      "method": "GET",
      "path": "/api/config",
      "auth": "ADMIN_PASSWORD",
      "roles": ["hub", "full"],
      "response": {
        "ok": "boolean",
        "_version": "integer",
        "providers": "object",
        "agent_models": "object",
        "settings": "object"
      }
    },
    "config_write": {
      "method": "POST",
      "path": "/api/config",
      "auth": "ADMIN_PASSWORD",
      "roles": ["hub", "full"],
      "request": {
        "_version": "integer",
        "providers": "object",
        "agent_models": "object",
        "settings": "object"
      },
      "conflict_response": {
        "status": 409,
        "body": {
          "ok": false,
          "error": "config_version_conflict",
          "current_version": "integer",
          "submitted_version": "integer"
        }
      }
    },
    "nodes_list": {
      "method": "GET",
      "path": "/api/admin/nodes",
      "auth": "ADMIN_PASSWORD",
      "roles": ["hub"],
      "response": {
        "ok": true,
        "nodes": "array of node objects"
      }
    },
    "nodes_issue": {
      "method": "POST",
      "path": "/api/admin/nodes",
      "auth": "ADMIN_PASSWORD",
      "roles": ["hub"],
      "request": {
        "name": "string",
        "role": "string (lite | full)",
        "lease_ttl": "integer",
        "grace_ttl": "integer",
        "scope": {
          "models": "array of strings",
          "providers": "array of strings"
        }
      },
      "response": {
        "ok": true,
        "node": "object",
        "node_token": "string (stk_node_<48hex>)",
        "bootstrap_env": "string"
      }
    },
    "nodes_patch": {
      "method": "PATCH",
      "path": "/api/admin/nodes/:id",
      "auth": "ADMIN_PASSWORD",
      "roles": ["hub"]
    },
    "nodes_rotate": {
      "method": "POST",
      "path": "/api/admin/nodes/:id/rotate",
      "auth": "ADMIN_PASSWORD",
      "roles": ["hub"],
      "response": {
        "ok": true,
        "node_token": "string (stk_node_<48hex>)",
        "bootstrap_env": "string"
      }
    },
    "nodes_delete": {
      "method": "DELETE",
      "path": "/api/admin/nodes/:id",
      "auth": "ADMIN_PASSWORD",
      "roles": ["hub"]
    },
    "node_config": {
      "method": "POST",
      "path": "/api/node/config",
      "auth": "NODE_TOKEN",
      "roles": ["hub"],
      "headers": {
        "Authorization": "Bearer stk_node_<48hex>",
        "If-None-Match": "optional etag"
      }
    },
    "usage": {
      "method": "GET",
      "path": "/api/admin/usage",
      "auth": "ADMIN_PASSWORD",
      "roles": ["full"],
      "params": {
        "period": "today | 7d | 30d | all",
        "tz": "string (e.g. Asia/Shanghai)"
      }
    },
    "traces": {
      "method": "GET",
      "path": "/api/admin/traces",
      "auth": "ADMIN_PASSWORD",
      "roles": ["full"],
      "response": {
        "ok": true,
        "traces": "array of RequestTrace objects"
      }
    },
    "mode_switch": {
      "method": "POST",
      "path": "/api/admin/mode",
      "auth": "ADMIN_PASSWORD",
      "roles": ["full"],
      "request": {
        "mode": "string (agent | kb)"
      },
      "response": {
        "ok": true,
        "mode": "string (agent | kb)"
      }
    },
    "probe_models": {
      "method": "POST",
      "path": "/api/admin/probe-models",
      "auth": "ADMIN_PASSWORD",
      "roles": ["hub", "full"],
      "request": {
        "provider": "string",
        "base_url": "string (optional)",
        "api_key": "string"
      },
      "response": {
        "ok": true,
        "models": "array of strings"
      }
    },
    "verify_key": {
      "method": "POST",
      "path": "/api/admin/verify-key",
      "auth": "ADMIN_PASSWORD",
      "roles": ["hub", "full"],
      "request": {
        "provider": "string",
        "base_url": "string (optional)",
        "api_key": "string"
      },
      "response": {
        "ok": true,
        "valid": "boolean",
        "status": "integer",
        "latency_ms": "integer (optional)",
        "models_count": "integer (optional)",
        "error": "string (optional)"
      }
    },
    "vault_manifest": {
      "method": "GET",
      "path": "/api/vault/manifest",
      "auth": "ADMIN_PASSWORD",
      "roles": ["hub"],
      "response": {
        "ok": true,
        "_version": "integer",
        "providers": "object"
      }
    },
    "vault_fetch": {
      "method": "POST",
      "path": "/api/vault/fetch",
      "auth": "ADMIN_PASSWORD",
      "roles": ["hub"],
      "request": {
        "provider": "string",
        "key_label": "string (optional)",
        "keys": "array of strings (optional)"
      },
      "response": {
        "ok": true,
        "provider": "string",
        "provider_config": "object"
      }
    }
  }
}
