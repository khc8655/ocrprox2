{
  "$comment": "Backend contract for LLMProxy2 shared Admin UI and Node communication across hub, lite, and full roles.",
  "version": 2,
  "capabilities": {
    "hub": {
      "vaultHub": true,
      "nodeManager": true,
      "vaultClient": false,
      "runModes": false,
      "kbModels": false,
      "oauthLogin": false,
      "usageAndTraces": false,
      "systemUpdate": false
    },
    "full": {
      "vaultHub": false,
      "nodeManager": false,
      "vaultClient": true,
      "runModes": true,
      "kbModels": true,
      "oauthLogin": true,
      "usageAndTraces": true,
      "systemUpdate": true
    },
    "lite": {
      "vaultHub": false,
      "nodeManager": false,
      "vaultClient": false,
      "runModes": false,
      "kbModels": false,
      "oauthLogin": false,
      "usageAndTraces": false,
      "systemUpdate": false
    }
  },
  "endpoints": {
    "config_read": {
      "method": "GET",
      "path": "/api/config",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "hub",
        "full"
      ],
      "response": {
        "ok": "boolean",
        "_version": "integer",
        "providers": "object",
        "search_providers": "object",
        "search_selection": "object ({ search: string[], fetch: string })",
        "agent_models": "object",
        "settings": "object"
      }
    },
    "config_write": {
      "method": "POST",
      "path": "/api/config",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "hub",
        "full"
      ],
      "request": {
        "_version": "integer",
        "providers": "object",
        "search_providers": "object (optional)",
        "search_selection": "object (optional, { search: string[], fetch: string })",
        "agent_models": "object",
        "settings": "object"
      },
      "conflict_response": {
        "status": 409,
        "body": {
          "ok": false,
          "error": "config_version_conflict",
          "current_version": "integer",
          "submitted_version": "integer"
        }
      }
    },
    "nodes_list": {
      "method": "GET",
      "path": "/api/admin/nodes",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "hub"
      ],
      "response": {
        "ok": true,
        "nodes": "array of node objects (includes optional sanitized telemetry snapshot)"
      }
    },
    "nodes_issue": {
      "method": "POST",
      "path": "/api/admin/nodes",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "hub"
      ],
      "request": {
        "name": "string",
        "role": "string (lite | full)",
        "lease_ttl": "integer",
        "grace_ttl": "integer",
        "mcp_url": "string (optional http/https URL without credentials)",
        "scope": {
          "models": "array of strings",
          "providers": "array of strings",
          "search_providers": "array of strings (optional, default ['*'])"
        }
      },
      "response": {
        "ok": true,
        "node": "object",
        "node_token": "string (stk_node_<48hex>)",
        "bootstrap_env": "string"
      }
    },
    "nodes_patch": {
      "method": "PATCH",
      "path": "/api/admin/nodes/:id",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "hub"
      ]
    },
    "nodes_rotate": {
      "method": "POST",
      "path": "/api/admin/nodes/:id/rotate",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "hub"
      ],
      "response": {
        "ok": true,
        "node_token": "string (stk_node_<48hex>)",
        "bootstrap_env": "string"
      }
    },
    "nodes_delete": {
      "method": "DELETE",
      "path": "/api/admin/nodes/:id",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "hub"
      ]
    },
    "node_config": {
      "method": "POST",
      "path": "/api/node/config",
      "auth": "NODE_TOKEN",
      "roles": [
        "hub"
      ],
      "headers": {
        "Authorization": "Bearer stk_node_<48hex>",
        "If-None-Match": "optional etag"
      },
      "request": {
        "telemetry": "optional runtime snapshot object piggybacked on demand (version, uptime_sec, playwright_ready, search_count, crawl_count, resting_keys, resting_keys_count, last_error)"
      }
    },
    "usage": {
      "method": "GET",
      "path": "/api/admin/usage",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "full"
      ],
      "params": {
        "period": "today | 7d | 30d | all",
        "tz": "string (e.g. Asia/Shanghai)"
      }
    },
    "traces": {
      "method": "GET",
      "path": "/api/admin/traces",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "full"
      ],
      "response": {
        "ok": true,
        "traces": "array of RequestTrace objects"
      }
    },
    "mode_switch": {
      "method": "POST",
      "path": "/api/admin/mode",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "full"
      ],
      "request": {
        "mode": "string (agent | kb)"
      },
      "response": {
        "ok": true,
        "mode": "string (agent | kb)"
      }
    },
    "probe_models": {
      "method": "POST",
      "path": "/api/admin/probe-models",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "hub",
        "full"
      ],
      "request": {
        "provider": "string",
        "base_url": "string (optional)",
        "api_key": "string"
      },
      "response": {
        "ok": true,
        "models": "array of strings"
      }
    },
    "verify_key": {
      "method": "POST",
      "path": "/api/admin/verify-key",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "hub",
        "full"
      ],
      "request": {
        "provider": "string",
        "base_url": "string (optional)",
        "api_key": "string"
      },
      "response": {
        "ok": true,
        "valid": "boolean",
        "status": "integer",
        "latency_ms": "integer (optional)",
        "models_count": "integer (optional)",
        "error": "string (optional)"
      }
    },
    "verify_search_key": {
      "method": "POST",
      "path": "/api/admin/verify-search-key",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "hub"
      ],
      "request": {
        "provider": "string",
        "key_label": "string (optional)",
        "api_key": "string (optional if stored in KV)",
        "adapter": "string (optional)",
        "base_url": "string (optional)",
        "request": "object (optional declarative HTTP probe spec)",
        "fetch": "object (optional declarative HTTP fetch fallback spec)"
      },
      "response": {
        "ok": true,
        "valid": "boolean",
        "status": "integer",
        "latency_ms": "integer (optional)",
        "error": "string (optional)"
      }
    },
    "vault_manifest": {
      "method": "GET",
      "path": "/api/vault/manifest",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "hub"
      ],
      "response": {
        "ok": true,
        "_version": "integer",
        "providers": "object"
      }
    },
    "vault_fetch": {
      "method": "POST",
      "path": "/api/vault/fetch",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "hub"
      ],
      "request": {
        "provider": "string",
        "key_label": "string (optional)",
        "keys": "array of strings (optional)"
      },
      "response": {
        "ok": true,
        "provider": "string",
        "provider_config": "object"
      }
    },
    "detect_provider": {
      "method": "POST",
      "path": "/api/admin/detect-provider",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "full"
      ],
      "request": {
        "base_url": "string (optional)",
        "api_key": "string (optional)",
        "provider": "string (optional)"
      },
      "response": {
        "ok": true,
        "base_url": "string",
        "normalized_base_url": "string",
        "protocols": "array of strings",
        "results": "object"
      }
    },
    "balance": {
      "method": "POST",
      "path": "/api/admin/balance",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "full"
      ],
      "request": {
        "provider": "string (optional)",
        "key_label": "string (optional)",
        "api_key": "string (optional)",
        "base_url": "string (optional)",
        "balance_url": "string (optional)",
        "balance_path": "string (optional)",
        "preset_id": "string (optional)"
      },
      "response": {
        "ok": true,
        "balance": "object"
      }
    },
    "test_provider": {
      "method": "POST",
      "path": "/api/admin/test-provider",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "full"
      ],
      "request": {
        "provider": "string",
        "key_label": "string (optional)",
        "model": "string (optional)",
        "protocol": "string (optional)",
        "batch": "boolean (optional)"
      },
      "response": {
        "ok": true,
        "results": "array of objects"
      }
    },
    "autolist_sync": {
      "method": "POST",
      "path": "/api/admin/autolist-sync",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "full"
      ],
      "request": {
        "provider": "string",
        "auto_include": "string (optional)",
        "apply": "boolean (optional)"
      },
      "response": {
        "ok": true,
        "models": "array of strings",
        "matched": "array of strings",
        "added": "array of strings"
      }
    },
    "presets_extra": {
      "method": "GET",
      "path": "/api/admin/presets-extra",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "full"
      ],
      "response": {
        "ok": true,
        "presets": "array of objects"
      }
    },
    "access_info": {
      "method": "GET",
      "path": "/api/admin/access-info",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "full"
      ],
      "response": {
        "ok": true,
        "mode": "string",
        "client_key_configured": "boolean",
        "client_key_masked": "string",
        "proxy_keys_count": "integer",
        "endpoints": "array of strings",
        "models": "array of strings"
      }
    },
    "access_key": {
      "method": "POST",
      "path": "/api/admin/access-key",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "full"
      ],
      "request": {
        "client_key": "string (optional)",
        "generate": "boolean (optional)"
      },
      "response": {
        "ok": true,
        "client_key": "string",
        "masked": "string"
      }
    },
    "auth_login": {
      "method": "POST",
      "path": "/api/admin/auth/login",
      "auth": "NONE",
      "roles": [
        "full"
      ],
      "request": {
        "password": "string"
      },
      "response": {
        "ok": true
      }
    },
    "auth_logout": {
      "method": "POST",
      "path": "/api/admin/auth/logout",
      "auth": "NONE",
      "roles": [
        "full"
      ],
      "response": {
        "ok": true
      }
    }
  },
  "auth_semantics": {
    "login": {
      "method": "POST",
      "path": "/api/admin/auth/login",
      "auth": "none"
    },
    "failure_unauthorized": {
      "status": 401,
      "when": "invalid credential, IP not locked"
    },
    "failure_locked": {
      "status": 429,
      "headers": {
        "Retry-After": "seconds"
      },
      "when": "IP locked after 5 wrong credentials within 10 minutes"
    },
    "credential_less_requests": {
      "counted_as_failure": false,
      "reason": "page loads and probes must not consume the anti-bruteforce budget"
    },
    "client_key_visibility": {
      "path": "/api/config",
      "field": "settings.client_key",
      "masked": false,
      "reason": "admin needs the value to configure gateway clients"
    }
  }
}
