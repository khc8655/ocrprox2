{
  "$comment": "Backend contract for LLMProxy2 shared Admin UI and Node communication across hub, lite, and full roles.",
  "version": 3,
  "$changelog": [
    "v3: removed POST /api/vault/sync (full sync replaced by on-demand fetch); POST /api/vault/fetch gains 409 provider_exists_local, wholesale replace of hub-managed fields on re-fetch, and imported_keys; GET /api/vault/manifest gains the agent_models route-template section; both endpoints now serve hub and full roles.",
    "v3.1: vault fetch no longer accepts caller-supplied hub_url/node_token (target is always the stored vault config; anti-exfiltration); provider_config gains api_type/rule_hash and no longer touches enabled; manifest candidates rename max_conc to max_concurrency and rule_hash is hub-computed from adapter_rules; /api/vault/manifest accepts POST (credentials in body instead of the query string); provider IDs with unsafe characters are refused at adoption.",
    "v2: initial published revision."
  ],
  "capabilities": {
    "hub": {
      "vaultHub": true,
      "nodeManager": true,
      "vaultClient": false,
      "kbModels": false,
      "oauthLogin": false,
      "usageAndTraces": false,
      "systemUpdate": false
    },
    "full": {
      "vaultHub": false,
      "nodeManager": false,
      "vaultClient": true,
      "kbModels": true,
      "oauthLogin": true,
      "usageAndTraces": true,
      "systemUpdate": true
    },
    "lite": {
      "vaultHub": false,
      "nodeManager": false,
      "vaultClient": false,
      "kbModels": false,
      "oauthLogin": false,
      "usageAndTraces": false,
      "systemUpdate": false
    }
  },
  "endpoints": {
    "config_read": {
      "method": "GET",
      "path": "/api/config",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "hub",
        "full"
      ],
      "response": {
        "ok": "boolean",
        "_version": "integer",
        "providers": "object",
        "agent_models": "object",
        "settings": "object"
      }
    },
    "config_write": {
      "method": "POST",
      "path": "/api/config",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "hub",
        "full"
      ],
      "request": {
        "_version": "integer",
        "providers": "object",
        "agent_models": "object",
        "settings": "object"
      },
      "conflict_response": {
        "status": 409,
        "body": {
          "ok": false,
          "error": "config_version_conflict",
          "current_version": "integer",
          "submitted_version": "integer"
        }
      }
    },
    "nodes_list": {
      "method": "GET",
      "path": "/api/admin/nodes",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "hub"
      ],
      "response": {
        "ok": true,
        "nodes": "array of node objects"
      }
    },
    "nodes_issue": {
      "method": "POST",
      "path": "/api/admin/nodes",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "hub"
      ],
      "request": {
        "name": "string",
        "role": "string (lite | full)",
        "lease_ttl": "integer",
        "grace_ttl": "integer",
        "scope": {
          "models": "array of strings",
          "providers": "array of strings"
        }
      },
      "response": {
        "ok": true,
        "node": "object",
        "node_token": "string (stk_node_<48hex>)",
        "bootstrap_env": "string",
        "install_command": "string"
      }
    },
    "nodes_patch": {
      "method": "PATCH",
      "path": "/api/admin/nodes/:id",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "hub"
      ]
    },
    "nodes_rotate": {
      "method": "POST",
      "path": "/api/admin/nodes/:id/rotate",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "hub"
      ],
      "response": {
        "ok": true,
        "node_token": "string (stk_node_<48hex>)",
        "client_key": "string",
        "bootstrap_env": "string",
        "install_command": "string"
      }
    },
    "nodes_install_command": {
      "method": "GET",
      "path": "/api/admin/nodes/:id/install-command",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "hub"
      ],
      "response": {
        "ok": true,
        "node": "object (sanitized)",
        "node_token": "string (stk_node_<48hex>)",
        "client_key": "string",
        "bootstrap_env": "string",
        "install_command": "string"
      },
      "errors": {
        "404": "node_not_found"
      },
      "semantics": "rotates the node token internally (old token invalidated immediately); Cache-Control: no-store"
    },
    "nodes_delete": {
      "method": "DELETE",
      "path": "/api/admin/nodes/:id",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "hub"
      ]
    },
    "node_config": {
      "method": "POST",
      "path": "/api/node/config",
      "auth": "NODE_TOKEN",
      "roles": [
        "hub"
      ],
      "headers": {
        "Authorization": "Bearer stk_node_<48hex>",
        "If-None-Match": "optional etag"
      }
    },
    "usage": {
      "method": "GET",
      "path": "/api/admin/usage",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "full"
      ],
      "params": {
        "period": "today | 7d | 30d | all",
        "tz": "string (e.g. Asia/Shanghai)"
      }
    },
    "traces": {
      "method": "GET",
      "path": "/api/admin/traces",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "full"
      ],
      "response": {
        "ok": true,
        "traces": "array of RequestTrace objects"
      }
    },
    "probe_models": {
      "method": "POST",
      "path": "/api/admin/probe-models",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "hub",
        "full"
      ],
      "request": {
        "provider": "string",
        "base_url": "string (optional)",
        "api_key": "string"
      },
      "response": {
        "ok": true,
        "models": "array of strings"
      }
    },
    "verify_key": {
      "method": "POST",
      "path": "/api/admin/verify-key",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "hub",
        "full"
      ],
      "request": {
        "provider": "string",
        "base_url": "string (optional)",
        "api_key": "string"
      },
      "response": {
        "ok": true,
        "valid": "boolean",
        "status": "integer",
        "latency_ms": "integer (optional)",
        "models_count": "integer (optional)",
        "error": "string (optional)"
      }
    },
    "vault_manifest": {
      "method": "GET | POST",
      "path": "/api/vault/manifest",
      "auth": "ADMIN_PASSWORD | NODE_TOKEN",
      "roles": [
        "hub",
        "full"
      ],
      "params": {
        "hub_url": "string (optional, full node only: hub override; POST body on POST, query string on GET)",
        "node_token": "string (optional, full node only: node token override; POST body on POST, query string on GET — POST preferred so the token stays out of access logs)"
      },
      "response": {
        "ok": true,
        "_version": "integer",
        "providers": {
          "<provider_id>": {
            "name": "string",
            "preset_id": "string",
            "base_url": "string",
            "anthropic_base_url": "string",
            "keys": "array of key-label strings",
            "rule_hash": "string (hub-computed content hash of the resolved adapter_rules; the node compares it with the hash it stored on fetch to detect rule drift)",
            "adapter_rules": "object"
          }
        },
        "agent_models": {
          "<model>": {
            "routing_strategy": "string",
            "active_key": "string",
            "no_reasoning": "boolean",
            "force_non_stream": "boolean",
            "allow_key_fallback": "boolean",
            "candidates": [
              {
                "provider": "string",
                "key_label": "string",
                "target_model": "string",
                "enabled": true,
                "weight": "integer",
                "max_concurrency": "integer"
              }
            ]
          }
        }
      },
      "semantics": "hub-managed manifest, metadata only (key labels, never plaintext). providers lists vault providers (origin=local excluded) with enabled key labels that carry key material (mirrors the routing projection); node tokens additionally see only their provider scope. rule_hash is computed hub-side from the same resolved adapter_rules that /api/vault/fetch returns, so a node can detect rule drift. agent_models are on-demand route templates: enabled routes only, filtered by the caller's model scope, and every candidate must reference a provider that survived into this manifest's providers section (dead candidates culled, a route with none left is dropped). Candidates carry key labels (key_label) and the per-candidate max_concurrency cap, not key material."
    },
    "vault_fetch": {
      "method": "POST",
      "path": "/api/vault/fetch",
      "auth": "ADMIN_PASSWORD | NODE_TOKEN",
      "roles": [
        "hub",
        "full"
      ],
      "request": {
        "provider": "string",
        "key_label": "string (optional: fetch a single key by label)",
        "keys": "array of strings (optional: fetch key labels as a subset)"
      },
      "response": {
        "ok": true,
        "provider": "string",
        "provider_config": {
          "name": "string",
          "preset_id": "string",
          "api_type": "string",
          "base_url": "string",
          "anthropic_base_url": "string",
          "hide_client_name": "boolean",
          "adapter_rules": "object",
          "rule_hash": "string (same hub-computed hash the manifest publishes)",
          "keys": "object (label -> key material; masked in the full-node echo)"
        },
        "imported_keys": "array of key-label strings (added by the full node on 200: vault keys that landed with this fetch)"
      },
      "errors": {
        "400": "invalid_json / provider_required / vault hub url not configured",
        "403": "provider_out_of_node_scope (hub, node token out of provider scope)",
        "404": "provider_not_found_or_local (hub)",
        "409": {
          "body": {
            "ok": false,
            "error": "provider_exists_local",
            "provider": "string"
          },
          "when": "full node only: the target provider already exists locally with origin=local or a legacy empty origin (delete or rename it first); re-checked under the config lock at import time"
        },
        "502": "hub unreachable, or hub returned 200 with a body that is not a JSON object (never echoed unmasked)"
      },
      "semantics": "on-demand single-provider fetch (replaces the removed full-sync POST /api/vault/sync). The fetch target is ALWAYS the configured vault (stored config URL + node token, or CLI defaults) — callers cannot override hub_url/node_token on this endpoint, so an admin-password leak cannot repoint the auto-import at an attacker hub. A full provider fetch (no key_label/keys) replaces the hub-managed fields (name/base_url/anthropic_base_url/adapter_rules/preset_id/api_type/hide_client_name/rule_hash) and the vault key list wholesale on the full node: keys deleted locally reappear and keys removed on the hub disappear. Provider enabled and per-key enabled are local operational toggles and are never taken from the payload. A key-label subset fetch (key_label or keys present) merges without dropping the other vault keys. Vault keys land with origin=vault; providers with a local/legacy-empty origin and local keys are never overwritten. The full node auto-imports the fetched provider and masks plaintext key material before echoing the hub response."
    },
    "detect_provider": {
      "method": "POST",
      "path": "/api/admin/detect-provider",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "full"
      ],
      "request": {
        "base_url": "string (optional)",
        "api_key": "string (optional)",
        "provider": "string (optional)"
      },
      "response": {
        "ok": true,
        "base_url": "string",
        "normalized_base_url": "string",
        "protocols": "array of strings",
        "results": "object"
      }
    },
    "test_provider": {
      "method": "POST",
      "path": "/api/admin/test-provider",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "full"
      ],
      "request": {
        "provider": "string",
        "key_label": "string (optional)",
        "model": "string (optional)",
        "protocol": "string (optional)",
        "batch": "boolean (optional)"
      },
      "response": {
        "ok": true,
        "results": "array of objects"
      }
    },
    "presets_extra": {
      "method": "GET",
      "path": "/api/admin/presets-extra",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "full"
      ],
      "response": {
        "ok": true,
        "presets": "array of objects"
      }
    },
    "access_info": {
      "method": "GET",
      "path": "/api/admin/access-info",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "full"
      ],
      "response": {
        "ok": true,
        "mode": "string",
        "client_key_configured": "boolean",
        "client_key_masked": "string",
        "proxy_keys_count": "integer",
        "endpoints": "array of strings",
        "models": "array of strings"
      }
    },
    "access_key": {
      "method": "POST",
      "path": "/api/admin/access-key",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "full"
      ],
      "request": {
        "client_key": "string (optional)",
        "generate": "boolean (optional)"
      },
      "response": {
        "ok": true,
        "client_key": "string",
        "masked": "string"
      }
    },
    "auth_login": {
      "method": "POST",
      "path": "/api/admin/auth/login",
      "auth": "NONE",
      "roles": [
        "full"
      ],
      "request": {
        "password": "string"
      },
      "response": {
        "ok": true
      }
    },
    "auth_logout": {
      "method": "POST",
      "path": "/api/admin/auth/logout",
      "auth": "NONE",
      "roles": [
        "full"
      ],
      "response": {
        "ok": true
      }
    },
    "system_version": {
      "method": "GET",
      "path": "/api/admin/system/version",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "full"
      ]
    },
    "system_check_update": {
      "method": "GET",
      "path": "/api/admin/system/check-update",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "full"
      ]
    },
    "system_upgrade": {
      "method": "POST",
      "path": "/api/admin/system/upgrade",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "full"
      ]
    },
    "system_restart": {
      "method": "POST",
      "path": "/api/admin/restart",
      "auth": "ADMIN_PASSWORD",
      "roles": [
        "full"
      ]
    }
  },
  "auth_semantics": {
    "login": {
      "method": "POST",
      "path": "/api/admin/auth/login",
      "auth": "none"
    },
    "failure_unauthorized": {
      "status": 401,
      "when": "invalid credential, IP not locked"
    },
    "failure_locked": {
      "status": 429,
      "headers": {
        "Retry-After": "seconds"
      },
      "when": "IP locked after 5 wrong credentials within 10 minutes"
    },
    "credential_less_requests": {
      "counted_as_failure": false,
      "reason": "page loads and probes must not consume the anti-bruteforce budget"
    },
    "client_key_visibility": {
      "path": "/api/config",
      "field": "settings.client_key",
      "masked": false,
      "reason": "admin needs the value to configure gateway clients"
    }
  }
}
